<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android" >
    <!-- pressed -->
    <item android:state_pressed="true" >
        <layer-list>
            <item>
                <shape android:shape="rectangle" >
                    <corners android:radius="30dp" />
                    <solid android:color="#4C4C4C" />
                </shape>
            </item>

            <item
                android:left="25dp"
                android:top="5dp"
                android:bottom="5dp">
                <bitmap android:src="@android:drawable/ic_menu_camera" android:gravity="left" android:alpha="1" />
            </item>
        </layer-list>
    </item>

    <!-- disabled -->
    <item android:state_enabled="false" android:alpha="0.5">
        <layer-list>
            <item>
                <shape android:shape="rectangle" >
                    <corners android:radius="30dp" />
                    <gradient
                        android:angle="270"
                        android:gradientRadius="45"
                        android:centerX="35%"
                        android:centerY="50%"
                        android:startColor="@color/nui_color_dg_start"
                        android:endColor="@color/nui_color_dg_end"
                        android:type="linear"
                        />

                    <stroke android:width="0dp" android:color="#56C161" />
                </shape>
            </item>

            <item
                android:left="25dp"
                android:top="5dp"
                android:bottom="5dp">
                <bitmap android:src="@android:drawable/ic_menu_camera" android:gravity="left" android:alpha="1" />
            </item>

        </layer-list>
    </item>

    <!-- normal -->
    <item android:top="2dp">
        <layer-list>

            <item>
                <shape android:shape="rectangle" >
                    <corners android:radius="30dp" />
                    <gradient
                        android:angle="270"
                        android:gradientRadius="45"
                        android:centerX="35%"
                        android:centerY="50%"
                        android:startColor="@color/nui_color_dg_start"
                        android:endColor="@color/nui_color_dg_end"
                        android:type="linear"
                        />
                    <stroke android:width="0dp" android:color="#56C161" />
                </shape>
            </item>

            <item
                android:left="25dp"
                android:top="5dp"
                android:bottom="5dp">
                <bitmap android:src="@android:drawable/ic_menu_camera" android:gravity="left" />
            </item>
        </layer-list>

        <!--
        <layer-list>
            <item>
